<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ rules. Only the listed paths travel, so files/adhoc and files/share
  are implicitly left behind. Device transfer has no size quota, so it also carries
  the one-off AI plate photos.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
        <include domain="file" path="adhoc/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
